{
  "title": "Invasion: crossing a tissue boundary",
  "sources": "12:38,39,40,41",
  "stages": [
    {
      "start": 0,
      "title": "Boundary",
      "text": "A tumor can enlarge without yet establishing a distant deposit. First examine its boundary with surrounding tissue."
    },
    {
      "start": 6.94,
      "title": "Invasion",
      "text": "Watch protease activity open a path through extracellular matrix and basement membrane. Reduced adhesion and increased migration help cells leave the original site."
    },
    {
      "start": 17.28,
      "title": "Metastasis",
      "text": "Entry into blood or lymph is not enough. Cells must survive transport and grow in a receptive distant environment. Local invasion and successful metastasis are separate steps."
    }
  ],
