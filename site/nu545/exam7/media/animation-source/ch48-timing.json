{
  "title": "Burns: edema with volume depletion",
  "sources": "48:46,47,48,54",
  "stages": [
    {
      "start": 0,
      "title": "Leak",
      "text": "After a major burn, fluid shifts out of the circulation and tissue edema develops. Watch fluid collect outside the vessel while the circulating supply falls."
    },
    {
      "start": 10.04,
      "title": "Replacement",
      "text": "Visible swelling does not prove adequate blood volume. Fluid replacement supports the circulation; increasing capillary permeability is not its purpose."
    },
    {
      "start": 19.74,
      "title": "Monitoring",
      "text": "The supplied deck identifies urine output as the most reliable resuscitation measure. Capillary seal marks the end of burn shock in this source."
    }
  ],
