{
  "title": "Pressure: from compression to ischemia",
  "sources": "46:27,28,29,30",
  "stages": [
    {
      "start": 0,
      "title": "Compression",
      "text": "Pressure over a bony prominence can compress the local capillary bed. Watch flow diminish as the tissue is compressed."
    },
    {
      "start": 7.58,
      "title": "Ischemia",
      "text": "Unrelieved pressure reduces oxygen delivery and can cause ischemia and necrosis. Depth matters: injury can extend from skin into deeper supporting tissues."
    },
    {
      "start": 17.42,
      "title": "Relief",
      "text": "Pressure relief and repositioning address the initiating force. An intact red surface and an exposed deep wound represent different findings; a covered wound base may prevent staging."
    }
  ],
