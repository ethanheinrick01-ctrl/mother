{
  "title": "Adipose tissue and cancer risk",
  "sources": "13:14,17",
  "stages": [
    {
      "start": 0,
      "title": "Active tissue",
      "text": "Adipose tissue is an active participant in the cancer-risk model. It releases adipokines."
    },
    {
      "start": 6.0,
      "title": "Interacting pathways",
      "text": "With obesity, the supplied deck links insulin resistance and hyperinsulinemia. Watch signaling increase around the tissue. This is a risk mechanism, not proof that a tumor will develop."
    },
    {
      "start": 18.1,
      "title": "Activity",
      "text": "Physical activity can reduce inflammatory mediators and insulin-like growth factors. The packet describes protection for selected cancers even without weight loss."
    }
  ],
