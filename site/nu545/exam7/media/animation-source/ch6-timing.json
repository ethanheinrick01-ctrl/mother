{
  "title": "Epigenetics: changing access",
  "sources": "6:4,6,10,26",
  "stages": [
    {
      "start": 0,
      "title": "Chromatin",
      "text": "DNA wraps around histone proteins. Tight packing is heterochromatin; loose packing is euchromatin."
    },
    {
      "start": 7.38,
      "title": "Silencing",
      "text": "Now add methyl groups at a promoter. The supplied cancer example links heavy promoter methylation with reduced tumor-suppressor transcription. The base sequence need not change."
    },
    {
      "start": 18.16,
      "title": "Different outcomes",
      "text": "A chemical modification can change gene activity. Different expression patterns help cells acquire different identities, even when they carry the same DNA."
    }
  ],
