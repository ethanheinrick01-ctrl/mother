{
  "title": "Transcription: making the message",
  "sources": "4:12,13",
  "stages": [
    {
      "start": 0,
      "title": "Template",
      "text": "Follow the DNA template. RNA polymerase binds at the promoter and builds a complementary messenger RNA strand."
    },
    {
      "start": 7.18,
      "title": "Message",
      "text": "Watch the RNA message lengthen and leave the template. This is transcription. The DNA sequence provides the information; the RNA carries a copy."
    },
    {
      "start": 15.92,
      "title": "Next step",
      "text": "Translation comes next at a ribosome. Transfer RNA matches messenger codons while a polypeptide is assembled. Do not confuse message production with protein assembly."
    }
  ],
