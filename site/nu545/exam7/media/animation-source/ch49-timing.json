{
  "title": "Perfusion before pressure falls",
  "sources": "49:5,6,17,18,25,26",
  "stages": [
    {
      "start": 0,
      "title": "Early shock",
      "text": "A child can have poor tissue perfusion while systolic pressure remains appropriate for age. This is compensated shock."
    },
    {
      "start": 7.6,
      "title": "Redistribution",
      "text": "Watch peripheral flow decrease as blood is redistributed. A normal pressure reading does not erase abnormal perfusion findings."
    },
    {
      "start": 14.7,
      "title": "Deterioration",
      "text": "Hypotension marks a later category. Bradycardia in a severely ill child can signal deterioration, and hypoxia is a common cause. Assess oxygen delivery and perfusion together."
    }
  ],
